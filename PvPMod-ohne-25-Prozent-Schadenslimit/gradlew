#!/usr/bin/env sh
# Lightweight bootstrap wrapper; downloads Gradle 9.2.1 on first run.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
GRADLE_VERSION=9.2.1
CACHE="${GRADLE_USER_HOME:-$HOME/.gradle}/wrapper/dists/manual-gradle-$GRADLE_VERSION"
BIN="$CACHE/gradle-$GRADLE_VERSION/bin/gradle"
if [ ! -x "$BIN" ]; then
  mkdir -p "$CACHE"
  ZIP="$CACHE/gradle.zip"
  echo "Downloading Gradle $GRADLE_VERSION..."
  if command -v curl >/dev/null 2>&1; then curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ZIP"
  elif command -v wget >/dev/null 2>&1; then wget -O "$ZIP" "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip"
  else echo 'Install curl or wget first.' >&2; exit 1; fi
  unzip -q "$ZIP" -d "$CACHE"
  rm -f "$ZIP"
fi
exec "$BIN" -p "$ROOT" "$@"
